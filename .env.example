# ==========================================
# Greenhouse Monitoring System - Environment
# ==========================================
# INSTRUCTIONS: 
# 1. Copy this file and rename it to exactly '.env'
# 2. Fill in your actual credentials below.
# 3. NEVER commit the real '.env' file to GitHub.

# --- Database Configuration (MongoDB Atlas) ---
# Replace <username> and <password> with your actual database credentials
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=greenhouse_db

# --- External APIs (OpenWeather) ---
# Get your free API key at https://openweathermap.org/
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_CITY=Akron
OPENWEATHER_COUNTRY=US
OPENWEATHER_UNITS=metric

# --- Application Settings ---
# Defines the default zone for ingestion scripts
ZONE=zone1